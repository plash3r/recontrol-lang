fn main() {
    let mut i: i32 = 0
    let mut sum: i32 = 0

    while i < 10 {
        i += 1
        if i == 3 {
            continue
        }
        if i == 6 {
            break
        }
        sum += i
    }

    println(sum)

    for (let mut j: i32 = 0; j < 3; j += 1) {
        if j == 1 {
            continue
        }
        sum += j
    }

    println(sum)
}

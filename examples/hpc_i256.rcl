// ============================================================
//  Recontrol HPC Demo — Large Integer Computations with i256
// ============================================================

// Greatest Common Divisor – Euclidean algorithm
fn gcd(a: i256, b: i256): i256 {
    let mut x: i256 = a
    let mut y: i256 = b
    while y != 0i256 {
        let temp: i256 = y
        y = x % y
        x = temp
    }
    return x
}

// Least Common Multiple via GCD identity: lcm(a,b) = |a*b| / gcd(a,b)
fn lcm(a: i256, b: i256): i256 {
    let g: i256 = gcd(a, b)
    if g == 0i256 {
        return 0i256
    }
    return (a / g) * b
}

// Modular exponentiation: base^exp mod m (square-and-multiply)
// Core primitive for RSA, Diffie-Hellman, etc.
fn modpow(base: i256, exp: i256, modulus: i256): i256 {
    if modulus == 1i256 {
        return 0i256
    }
    let mut result: i256 = 1i256
    let mut b: i256 = base % modulus
    let mut e: i256 = exp
    while e > 0i256 {
        let check: i256 = e % 2i256
        if check == 1i256 {
            result = (result * b) % modulus
        }
        b = (b * b) % modulus
        e = e / 2i256
    }
    return result
}

// Large Fibonacci – iterative O(n), F(200) ≈ 2.8×10⁴¹ fits i256
fn fibonacci(n: i256): i256 {
    if n <= 1i256 {
        return n
    }
    let mut a: i256 = 0i256
    let mut b: i256 = 1i256
    let mut i: i256 = 2i256
    while i <= n {
        let c: i256 = a + b
        a = b
        b = c
        i = i + 1i256
    }
    return b
}

// Factorial modulo modulus: (n! % mod)
fn factorial_mod(n: i256, modulus: i256): i256 {
    if n <= 1i256 {
        return 1i256 % modulus
    }
    let mut result: i256 = 1i256
    let mut i: i256 = 2i256
    while i <= n {
        result = (result * i) % modulus
        i = i + 1i256
    }
    return result
}

// Sum of arithmetic series: 1 + 2 + ... + n
fn arithmetic_sum(n: i256): i256 {
    return n * (n + 1i256) / 2i256
}

// Sum of squares: 1² + 2² + ... + n²
fn sum_of_squares(n: i256): i256 {
    return n * (n + 1i256) * (2i256 * n + 1i256) / 6i256
}

// ============================================================
//  Main – run all benchmarks
// ============================================================
fn main() {
    println("=== Recontrol HPC — i256 Number Theory ===")

    // GCD & LCM
    let g: i256 = gcd(2520i256, 3465i256)
    let l: i256 = lcm(2520i256, 3465i256)

    // Fibonacci: F(50), F(100), F(200)
    let f50: i256 = fibonacci(50i256)
    let f100: i256 = fibonacci(100i256)
    let f200: i256 = fibonacci(200i256)

    // Modular exponentiation (RSA-style)
    let mp: i256 = modpow(3i256, 100i256, 1000000007i256)
    let rsa: i256 = modpow(7i256, 256i256, 2305843009213693951i256)

    // Factorial modulo large prime
    let fact50: i256 = factorial_mod(50i256, 1000000007i256)
    let fact100: i256 = factorial_mod(100i256, 1000000007i256)

    // Series sums
    let s1: i256 = arithmetic_sum(1000000i256)
    let s2: i256 = sum_of_squares(100000i256)

    // Large GCD stress test
    let a: i256 = 123456789012345678901234567890i256
    let b: i256 = 987654321098765432109876543210i256
    let gbig: i256 = gcd(a, b)

    println("All HPC benchmarks completed.")
}

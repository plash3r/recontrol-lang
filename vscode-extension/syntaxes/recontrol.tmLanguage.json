{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Recontrol Lang",
  "scopeName": "source.rcl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rcl",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rcl",
      "begin": """,
      "end": """,
      "patterns": [
        {
          "name": "constant.character.escape.rcl",
          "match": "\\\\(?:[nrt\\"0]|x[0-9A-Fa-f]{2})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.rcl",
          "match": "\\b(?:[0-9]+\\.[0-9]+)(?:[fF](?:32|64|128))?\\b"
        },
        {
          "name": "constant.numeric.integer.rcl",
          "match": "\\b[0-9]+(?:i|u)(?:8|16|32|64|128|256)\\b"
        },
        {
          "name": "constant.numeric.integer.rcl",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rcl",
          "match": "\\b(?:if|else|for|while|do|return)\\b"
        },
        {
          "name": "storage.type.rcl",
          "match": "\\b(?:let|mut)\\b"
        },
        {
          "name": "storage.modifier.rcl",
          "match": "\\b(?:fn|struct|impl)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.rcl",
          "match": "\\b(?:i8|i16|i32|i64|i128|i256|u8|u16|u32|u64|u128|u256|f32|f64|f128|bool|char|str|void)\\b"
        },
        {
          "name": "storage.type.reference.rcl",
          "match": "&(?:\\s*mut\\s+)?"
        },
        {
          "name": "entity.name.type.rcl",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.rcl",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rcl",
          "match": "\\b(?:fn\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.rcl" }
          }
        },
        {
          "name": "support.function.builtin.rcl",
          "match": "\\b(?:print|println)\\b"
        },
        {
          "name": "entity.name.function.call.rcl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.rcl",
          "match": "(?:\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.rcl",
          "match": "(?:==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.rcl",
          "match": "(?:&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.arithmetic.rcl",
          "match": "(?:\\+\\+|--|\\+|-|\\*|/|%|!)"
        },
        {
          "name": "keyword.operator.reference.rcl",
          "match": "&"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.parameters.rcl",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.block.rcl",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.array.rcl",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.rcl",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.rcl",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.rcl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
